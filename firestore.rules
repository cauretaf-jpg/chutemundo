rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isChuteAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'cauretaf@gmail.com'
      );
    }

    match /chuteMundo/sharedState {
      allow read: if true;
      allow create, update, delete: if isChuteAdmin();
    }
  }
}
